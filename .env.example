# =============================================================================
# auth-audit — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit your real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# INPUT / OUTPUT PATHS
# -----------------------------------------------------------------------------

# Path to the proxy host JSON input file
PROXY_HOSTS_FILE=data/proxy_hosts.json

# Directory where all output artifacts are written
OUTPUT_DIR=output

# JSON results file path (relative to OUTPUT_DIR or absolute)
RESULTS_JSON=output/results.json

# HTML report file path
RESULTS_HTML=output/results.html

# Directory for browser screenshots captured during Tier 3 escalation
SCREENSHOTS_DIR=output/screenshots

# -----------------------------------------------------------------------------
# TIER 0 — API ROUTE DISCOVERY (wordlist / kiterunner)
# -----------------------------------------------------------------------------

# Enable Phase 0 route discovery for domains with mostly 404 responses
DISCOVERY_ENABLED=true

# Minimum ratio of 404s in initial probes to trigger Phase 0 (0.0–1.0)
DISCOVERY_TRIGGER_404_RATIO=0.9

# Enable kiterunner binary (requires 'kr' on PATH — optional, powerful)
KITERUNNER_ENABLED=false
# KITERUNNER_BINARY=kr
# KITERUNNER_WORDLIST=/path/to/routes.kite

# -----------------------------------------------------------------------------
# ── Data Gathering — HTTP Probing ─────────────────────────────────
# -----------------------------------------------------------------------------

# Maximum number of concurrent HTTP probe workers
PROBER_CONCURRENCY=10

# HTTP request timeout in seconds (connect + read)
HTTP_TIMEOUT=15

# Maximum number of redirects to follow per request
HTTP_MAX_REDIRECTS=10

# Maximum body preview size in bytes captured per probe response
BODY_PREVIEW_BYTES=8192

# Comma-separated list of custom web paths to probe (overrides defaults if set)
# CUSTOM_WEB_PATHS=

# Comma-separated list of custom API paths to probe (overrides defaults if set)
# CUSTOM_API_PATHS=

# User-Agent header sent with all HTTP probes
HTTP_USER_AGENT=auth-audit/0.1 (security audit pipeline)

# -----------------------------------------------------------------------------
# TIER 2 — Local LLM / LLM REASONING
# -----------------------------------------------------------------------------

# Base URL of the Local LLM-compatible OpenAI API endpoint
LLM_BASE_URL=http://localhost:8000/v1

# Local LLM API key — set to any non-empty value if the endpoint requires one
# LLM_API_KEY=

# Model identifier to use for LLM reasoning
LLM_MODEL=qwen3.6-27b

# Maximum tokens the LLM may generate per response
LLM_MAX_TOKENS=2048

# Sampling temperature for LLM calls (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0.1

# Maximum number of concurrent Local LLM analysis tasks
LLM_CONCURRENCY=5

# Timeout in seconds for Local LLM API requests
LLM_TIMEOUT=120.0

# Maximum characters of summarized HTML sent to the LLM per domain
LLM_MAX_HTML_CHARS=4000

# Minimum rule_score below which Tier 2 is always invoked
TIER2_ESCALATION_THRESHOLD=60

# -----------------------------------------------------------------------------
# TIER 3 — HERMES BROWSER AUTOMATION
# -----------------------------------------------------------------------------

# Base URL of the Hermes Agent API (OpenAI-compatible chat endpoint with browser capabilities)
HERMES_BASE_URL=http://localhost:8080/v1

# Hermes Agent API key
HERMES_API_KEY=your-hermes-api-key

# Timeout in seconds for a single Hermes browser task (browser tasks are slow — allow 120+s)
HERMES_TASK_TIMEOUT=120

# Maximum number of concurrent Hermes browser tasks
HERMES_CONCURRENCY=5

# -----------------------------------------------------------------------------
# RETRY / RESILIENCE
# -----------------------------------------------------------------------------

# Maximum retry attempts for transient network errors (Tier 1)
HTTP_RETRY_ATTEMPTS=3

# Base wait time in seconds between retries (exponential backoff)
HTTP_RETRY_WAIT=1.0

# Maximum retry attempts for Local LLM API calls
LLM_RETRY_ATTEMPTS=2

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# If set to true, pretty-print Rich console output; false for plain text
LOG_RICH=true

# Optional path to write log output to a file (leave blank for stdout only)
# LOG_FILE=output/audit.log

# -----------------------------------------------------------------------------
# SCREENSHOT STORAGE — Ceph / S3-compatible object store
# -----------------------------------------------------------------------------
# Hermes takes screenshots server-side during browser analysis. When S3 is
# configured, Hermes uploads each screenshot directly to the bucket and returns
# the public URL. The HTML report then embeds them as <img> tags.
# Leave S3_ENDPOINT unset to skip uploads entirely.

# S3-compatible endpoint (Ceph RadosGW, MinIO, etc.)
# S3_ENDPOINT=http://s3.amazonaws.com
# S3_BUCKET=auth-audit-screenshots
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Object key prefix — screenshots land at:
# s3://auth-audit-screenshots/auth-audit/screenshots/{domain}/{YYYY-MM-DD}/{uuid}.png
# S3_SCREENSHOT_PREFIX=auth-audit/screenshots

# Object key prefix for HTML reports and JSONL checkpoints:
# S3_REPORT_PREFIX=auth-audit/reports
